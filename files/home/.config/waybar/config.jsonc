{
  "layer": "top",
  "height": 30,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "cpu", "custom/cpu_voltage", "temperature", "memory", "custom/gpu", "network"],
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "pulseaudio": { "format": "{volume}% <span color='#33ccff'>{icon}</span>", "format-muted": "<span color='#33ccff'>\udb81\udd81</span> muted", "format-icons": { "default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"] }, "on-click": "pavucontrol" },
  "cpu": { "format": "{usage}% {avg_frequency:.2f} GHz", "states": { "warning": 70, "critical": 90 } },
  "temperature": { "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon", "input-filename": "temp1_input", "format": "CPU {temperatureC}°C", "warning-threshold": 75, "critical-threshold": 85 },
  "memory": { "format": "{used:0.1f}G <span color='#33ccff'>\udb80\udf5b</span>", "states": { "warning": 80, "critical": 90 } },
  "custom/cpu_voltage": { "exec": "~/.config/waybar/scripts/cpu_voltage.sh", "interval": 2, "format": "Vcore {}" },
  "custom/gpu": { "exec": "cat \"$XDG_RUNTIME_DIR/waybar-gpu.json\" 2>/dev/null", "interval": 2, "return-type": "json" },
  "network": { "format-ethernet": "{ipaddr} <span color='#33ccff'>\udb80\ude00</span>", "format-wifi": "{essid} {signalStrength}% <span color='#33ccff'>\udb81\udda9</span>", "tooltip-format-wifi": "{ipaddr}", "format-disconnected": "offline ⚠" }
}
